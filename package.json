{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "HFSS desktop agent: bring your own OpenAI-compatible model API, with Hindsight memory",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fake": "electron-vite dev -- --fake-model",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "set-key": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-key.ps1",
    "install-hindsight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-hindsight.ps1",
    "hindsight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-hindsight.ps1",
    "install-hfss": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-hfss.ps1",
    "test:hfss": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-hfss.ps1",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "author": "1018-clz"
}
